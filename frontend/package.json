{
  "name": "localrag-workspace",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:client": "python ../scripts/export_agent_platform_openapi.py && openapi-typescript openapi.json -o src/shared/api/schema.d.ts",
    "build": "npm run generate:client && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.45.0",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
